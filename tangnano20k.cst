// CLK 
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP;

// resetn
IO_LOC "reset" 88;


// LEDS
IO_LOC "leds_n[0]" 15;
IO_LOC "leds_n[1]" 16;
IO_LOC "leds_n[2]" 17;
IO_LOC "leds_n[3]" 18;
IO_LOC "leds_n[4]" 19;
IO_LOC "leds_n[5]" 20;

IO_PORT "leds_n[0]" PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[1]" PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[2]" PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[3]" PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[4]" PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[5]" PULL_MODE=UP DRIVE=8;

// UART

IO_LOC "uart_tx" 69;
IO_LOC "uart_rx" 70;

